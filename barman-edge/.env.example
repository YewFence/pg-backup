BARMAN_IMAGE=ghcr.io/yewfence/pg-backup/barman:latest
BARMAN_CONTAINER_NAME=barman-edge
BARMAN_VOLUME=

BARMAN_UID=1000
BARMAN_GID=1000
BARMAN_FIX_OWNERSHIP=true

POSTGRES_NETWORK_NAME=pg-net

# Barman 通过 boto3 读取这些变量。AWS S3 使用默认端点时将 AWS_ENDPOINT_URL 留空。
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=us-east-1
AWS_ENDPOINT_URL=

# 某些 S3 兼容实现需要关闭 boto3 1.36+ 的强制校验和行为。
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

HEALTH_CHECK_HOST=127.0.0.1
HEALTH_CHECK_PORT=8000
CHECK_INTERVAL=300
FAIL_THRESHOLD=3
