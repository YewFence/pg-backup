# PostgreSQL 主服务配置，密码会显式注入容器，端口、容器名、网络名只用于 Compose 展开。
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=change-to-a-strong-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONTAINER_NAME=postgres
POSTGRES_NETWORK_NAME=pg-net

# 数据卷配置，默认固定卷名，避免 Compose project name 变化后挂载到新卷。
POSTGRES_DATA_VOLUME_NAME=postgres_data
POSTGRES_DATA_PATH=/srv/native-docker/postgres
POSTGRES_RESTORE_ROOT=/srv/native-docker/postgres-restore

# Barman 流复制备份用户配置，初始化脚本会在首次创建数据库时使用。
BARMAN_PASSWORD=change-to-a-strong-password
STREAMING_BARMAN_PASSWORD=change-to-a-strong-password

# Alloy PostgreSQL exporter 监控用户配置，初始化脚本会创建 postgres_exporter 并授予 pg_monitor。
# 这个密码需要和 edge/alloy-agent 的 POSTGRES_DATA_SOURCE_NAMES 连接串保持一致。
POSTGRES_EXPORTER_PASSWORD=change-to-a-strong-password
